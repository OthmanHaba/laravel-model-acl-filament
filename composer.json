{
    "name": "othmanhaba/laravel-model-acl-filament",
    "description": "Filament v4/v5 UI to manage laravel-model-acl access rules and their assignments to users and roles",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Othman Haba",
            "email": "othman.hadi2002@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "othmanhaba/laravel-model-acl": "^0.1",
        "filament/filament": "^4.0|^5.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Assign access rules to roles as well as users"
    },
    "autoload": {
        "psr-4": {
            "OthmanHaba\\LaravelModelAclFilament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OthmanHaba\\LaravelModelAclFilament\\LaravelModelAclFilamentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
